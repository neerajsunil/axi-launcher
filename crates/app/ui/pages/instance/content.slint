import { Theme } from "../../theme.slint";
import { Icons } from "../../icons.slint";
import { Nav, Page, DialogKind } from "../../nav.slint";
import { InstancesApi } from "../../api/instances.slint";
import { ModsApi, ContentKinds } from "../../api/mods.slint";
import { ModItem } from "../../api/types.slint";
import { Button, ButtonKind, ButtonSize } from "../../components/button.slint";
import { TextField } from "../../components/text-field.slint";
import { Toggle } from "../../components/toggle.slint";
import { Card, Badge } from "../../components/card.slint";
import { ScrollView } from "../../components/scroll-view.slint";

import { Segmented } from "../../components/segmented.slint";
import { ModIcon } from "../../components/mod-icon.slint";
import { SkeletonList, Delayed } from "../../components/skeleton.slint";
import { EmptyState } from "../../components/empty-state.slint";
import { Spinner } from "../../components/spinner.slint";

component ContentRow inherits Rectangle {
    in property <ModItem> item;
    callback toggled(bool);
    callback update();
    callback change-version();
    callback remove();

    height: 60px;
    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.surface-hover : transparent;

    touch := TouchArea { }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 12px;

        ModIcon {
            icon: root.item.icon;
            has-icon: root.item.has-icon;
            initial: root.item.initial;
            size: 38px;
            y: (parent.height - self.height) / 2;
            opacity: root.item.enabled ? 1 : 0.45;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.item.title;
                    color: root.item.enabled ? Theme.text : Theme.text-faint;
                    font-size: Theme.font-body;
                    font-weight: 700;
                    overflow: elide;
                }
                if root.item.installing: HorizontalLayout {
                    spacing: 6px;
                    Spinner {
                        size: 12px;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: "Downloading";
                        color: Theme.accent;
                        font-size: Theme.font-tiny;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                if root.item.update-available && !root.item.installing: Badge {
                    text: "Update available";
                    text-color: Theme.info;
                    fill: Theme.info-soft;
                }
                if root.item.pinned: Badge {
                    text: "Pinned version";
                }
                if root.item.dependency: Badge {
                    text: "Dependency";
                }
                if !root.item.enabled: Badge {
                    text: "Disabled";
                }
            }
            Text {
                text: (root.item.version != "" ? root.item.version + " · " : "") + root.item.file-name
                    + (root.item.source != "" ? " · " + root.item.source : "");
                color: Theme.text-faint;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }
        if root.item.update-available: Button {
            text: "Update";
            icon: Icons.download;
            size: ButtonSize.small;
            loading: root.item.installing;
            y: (parent.height - self.height) / 2;
            clicked => {
                root.update();
            }
        }
        // Manually added files have no known project, so no versions to pick from.
        if root.item.has-versions: Button {
            icon: Icons.tag;
            tooltip: "Choose version";
            kind: ButtonKind.ghost;
            enabled: !root.item.installing;
            y: (parent.height - self.height) / 2;
            clicked => {
                root.change-version();
            }
        }
        Toggle {
            width: 38px;
            checked: root.item.enabled;
            y: (parent.height - self.height) / 2;
            toggled(on) => {
                root.toggled(on);
            }
        }
        Button {
            icon: Icons.trash;
            tooltip: "Remove";
            kind: ButtonKind.ghost;
            y: (parent.height - self.height) / 2;
            clicked => {
                root.remove();
            }
        }
    }
}

// Installed mods, resource packs and shaders of the selected instance, one kind at a time.
export component InstanceContent inherits VerticalLayout {
    property <string> id: InstancesApi.selected.id;
    property <int> kind: ModsApi.kind;
    property <string> noun: ContentKinds.plural[root.kind];
    property <image> kind-icon: root.kind == ContentKinds.resource-packs ? Icons.image
        : root.kind == ContentKinds.shaders ? Icons.sun : Icons.package;
    property <bool> modded: InstancesApi.selected.loader-index != 0;
    // Mods and shaders only work with a mod loader.
    property <bool> blocked: !root.modded && root.kind != ContentKinds.resource-packs;
    // ModsApi describes this instance and kind (the switcher changes `kind` a tick before
    // the new list arrives), and has finished reading it.
    property <bool> current: ModsApi.shown-instance == root.id && ModsApi.shown-kind == root.kind;
    property <bool> ready: root.current && !ModsApi.loading;
    property <bool> needs-iris: root.kind == ContentKinds.shaders && root.modded && root.ready && !ModsApi.shader-loader;

    property <bool> can-change-game: !InstancesApi.selected.running && !InstancesApi.selected.busy;
    changed id => {
        ModsApi.refresh(root.id, root.kind);
    }
    init => {
        ModsApi.filter("");
        ModsApi.refresh(root.id, root.kind);
    }

    spacing: 14px;
    padding-bottom: Theme.page-padding;

    HorizontalLayout {
        spacing: 10px;
        Segmented {
            options: ContentKinds.labels;
            current <=> ModsApi.kind;
            selected(kind) => {
                ModsApi.refresh(root.id, kind);
            }
        }
        if !root.blocked: TextField {
            icon: Icons.search;
            placeholder: "Filter " + root.noun;
            edited(text) => {
                ModsApi.filter(text);
            }
        }
        if root.blocked: Rectangle { horizontal-stretch: 1; }
        if !root.blocked: Button {
            text: ModsApi.checking-updates ? "Checking" : "Check for updates";
            icon: Icons.refresh;
            loading: ModsApi.checking-updates;
            enabled: root.current && ModsApi.installed-count > 0;
            tooltip: ModsApi.installed-count == 0 ? "Nothing installed to check" : "";
            clicked => {
                ModsApi.check-updates(root.id, root.kind);
            }
        }
        if !root.blocked && ModsApi.update-count > 0: Button {
            text: "Update all (" + ModsApi.update-count + ")";
            icon: Icons.download;
            clicked => {
                ModsApi.update-all(root.id, root.kind);
            }
        }
        Button {
            icon: Icons.folder;
            tooltip: "Open the " + root.noun + " folder";
            clicked => {
                ModsApi.open-folder(root.id, root.kind);
            }
        }
        if !root.blocked: Button {
            text: "Add " + root.noun;
            icon: Icons.plus;
            kind: ButtonKind.primary;
            clicked => {
                Nav.page = Page.browse-content;
            }
        }
    }


    // Vanilla instances can't run mods or shaders.
    if root.blocked: Card {
        vertical-stretch: 1;
        EmptyState {
            icon: root.kind-icon;
            title: root.kind == ContentKinds.shaders ? "Shaders need a mod loader" : "Mods need a mod loader";
            text: root.kind == ContentKinds.shaders
                ? "Switch to Fabric or NeoForge to use shaders."
                : "Switch to Fabric or NeoForge to add mods.";
            Button {
                text: "Choose a mod loader";
                icon: Icons.layers;
                kind: ButtonKind.primary;
                enabled: root.can-change-game;
                tooltip: root.can-change-game ? "" : "Stop the game first";
                clicked => {
                    Nav.dialog = DialogKind.change-version;
                }
            }
        }
    }

    // Shader packs do nothing without Iris (or Oculus).
    if root.needs-iris: Card {
        background: Theme.accent-soft;
        border-color: transparent;
        HorizontalLayout {
            padding: 14px;
            padding-left: 18px;
            spacing: 14px;
            Image {
                source: Icons.sun;
                colorize: Theme.accent;
                width: 22px;
                height: 22px;
                y: (parent.height - self.height) / 2;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: "Shaders need Iris";
                    color: Theme.text;
                    font-weight: 700;
                }
                Text {
                    text: "Install it once and you're set.";
                    color: Theme.text-muted;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }
            }
            Button {
                text: ModsApi.shader-loader-installing ? "Installing" : "Install Iris";
                icon: Icons.download;
                kind: ButtonKind.primary;
                loading: ModsApi.shader-loader-installing;
                y: (parent.height - self.height) / 2;
                clicked => {
                    ModsApi.install-shader-loader(root.id);
                }
            }
        }
    }

    if !root.blocked: Card {
        vertical-stretch: 1;

        // Placeholder rows, only if reading the folder takes a moment.
        if !root.ready && !(root.current && ModsApi.installed.length > 0): Delayed {
            delay: 120ms;
            VerticalLayout {
                padding: 6px;
                padding-top: 38px;
                SkeletonList {
                    rows: 7;
                    icon-size: 38px;
                }
            }
        }

        if root.ready && ModsApi.installed.length == 0: EmptyState {
            icon: ModsApi.installed-count == 0 ? root.kind-icon : Icons.search;
            title: ModsApi.installed-count == 0 ? "No " + root.noun + " yet" : "No " + root.noun + " match";
            text: ModsApi.installed-count == 0
                ? "Browse Modrinth and CurseForge for " + root.noun + " that work with this instance, or drop files into its folder."
                : "Try a different filter.";
            if ModsApi.installed-count == 0: Button {
                text: "Browse " + root.noun;
                icon: Icons.compass;
                kind: ButtonKind.primary;
                clicked => {
                    Nav.page = Page.browse-content;
                }
            }
        }

        if root.current && ModsApi.installed.length > 0: VerticalLayout {
            padding: 6px;
            spacing: 4px;
            HorizontalLayout {
                padding-left: 12px;
                height: 26px;
                Text {
                    text: ModsApi.installed-count + " " + (ModsApi.installed-count == 1 ? ContentKinds.singular[root.kind] : root.noun)
                        + (ModsApi.disabled-count > 0 ? " · " + ModsApi.disabled-count + " disabled" : "");
                    color: Theme.text-muted;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
            }
            ScrollView {
                vertical-stretch: 1;
                spacing: 2px;
                for item in ModsApi.installed: ContentRow {
                    item: item;
                    toggled(on) => {
                        ModsApi.set-enabled(root.id, root.kind, item.file-name, on);
                    }
                    update => {
                        ModsApi.update(root.id, root.kind, item.file-name);
                    }
                    change-version => {
                        ModsApi.open-versions(root.id, root.kind, item.file-name);
                        Nav.dialog = DialogKind.mod-versions;
                    }
                    remove => {
                        ModsApi.remove(root.id, root.kind, item.file-name);
                    }
                }
            }
        }
    }
}
