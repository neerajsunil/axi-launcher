import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Nav, Page, DialogKind } from "../nav.slint";
import { InstancesApi } from "../api/instances.slint";
import { ModpacksApi } from "../api/modpacks.slint";
import { Button, ButtonKind } from "../components/button.slint";
import { TextField } from "../components/text-field.slint";
import { Segmented } from "../components/segmented.slint";
import { InstanceCard } from "../components/instance-card.slint";
import { Card } from "../components/card.slint";
import { EmptyState } from "../components/empty-state.slint";
import { PageHeader } from "../components/page.slint";

// Every instance as a grid of cards, with search and sorting.
export component InstancesPage inherits Rectangle {
    property <length> gap: 16px;
    property <length> min-card-width: 260px;
    property <int> columns: max(1, floor((grid.width + root.gap) / (root.min-card-width + root.gap)));
    property <length> card-width: (grid.width - (root.columns - 1) * root.gap) / root.columns;
    property <length> card-height: 156px;
    // "On your network" sits under the instances; hidden while searching.
    property <bool> show-lan: InstancesApi.lan-available.length > 0 && InstancesApi.items.length == InstancesApi.total-count;
    property <length> lan-top: ceil(InstancesApi.items.length / root.columns) * (root.card-height + root.gap) + (InstancesApi.items.length > 0 ? 12px : 0);
    property <length> lan-title-height: 40px;
    property <length> lan-card-height: 68px;
    property <int> lan-rows: ceil(InstancesApi.lan-available.length / root.columns);

    // The search box starts empty, so the list must too.
    init => {
        InstancesApi.search-changed("");
    }

    VerticalLayout {
        padding: Theme.page-padding;
        padding-bottom: 0;
        spacing: 20px;

        PageHeader {
            title: "Library";
            subtitle: InstancesApi.total-count == 0 ? "Your worlds start here"
                : InstancesApi.total-count == 1 ? "1 instance" : InstancesApi.total-count + " instances";
            Button {
                text: "Import";
                icon: Icons.upload;
                tooltip: "Import a modpack file";
                clicked => {
                    ModpacksApi.import-file();
                }
            }
            Button {
                text: "New instance";
                icon: Icons.plus;
                kind: ButtonKind.primary;
                clicked => {
                    Nav.dialog = DialogKind.new-instance;
                }
            }
        }

        if InstancesApi.total-count > 0: HorizontalLayout {
            spacing: 12px;
            TextField {
                icon: Icons.search;
                placeholder: "Search";
                edited(text) => {
                    InstancesApi.search-changed(text);
                }
            }
            Segmented {
                options: ["Recent", "Name"];
                current <=> InstancesApi.sort;
                selected => {
                    InstancesApi.sort-changed();
                }
            }
        }

        grid := Flickable {
            vertical-stretch: 1;
            content-height: root.lan-top + (root.show-lan ? root.lan-title-height + root.lan-rows * (root.lan-card-height + root.gap) : 0) + Theme.page-padding;

            for item[i] in InstancesApi.items: InstanceCard {
                x: mod(i, root.columns) * (root.card-width + root.gap);
                y: floor(i / root.columns) * (root.card-height + root.gap);
                width: root.card-width;
                height: root.card-height;
                item: item;
                open => {
                    InstancesApi.select(item.id);
                    Nav.instance-tab = 0;
                    Nav.page = Page.instance;
                }
                play => {
                    InstancesApi.play(item.id);
                }
                stop => {
                    InstancesApi.stop(item.id);
                }
            }

            // Synced instances on the user's other computers that aren't here yet.
            if root.show-lan: Text {
                x: 0;
                y: root.lan-top;
                height: root.lan-title-height - 12px;
                text: "On your network";
                color: Theme.text;
                font-size: Theme.font-large;
                font-weight: 700;
                vertical-alignment: center;
            }
            for item[i] in root.show-lan ? InstancesApi.lan-available : []: Card {
                x: mod(i, root.columns) * (root.card-width + root.gap);
                y: root.lan-top + root.lan-title-height + floor(i / root.columns) * (root.lan-card-height + root.gap);
                width: root.card-width;
                height: root.lan-card-height;
                HorizontalLayout {
                    padding: 14px;
                    spacing: 12px;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: Theme.radius;
                        background: Theme.info.with-alpha(0.12);
                        y: (parent.height - self.height) / 2;
                        Image {
                            source: Icons.cloud;
                            colorize: Theme.info;
                            width: 18px;
                            height: 18px;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: item.name;
                            color: Theme.text;
                            font-size: Theme.font-body;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: item.detail + " · on " + item.device;
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            overflow: elide;
                        }
                    }
                    Button {
                        text: "Add";
                        icon: Icons.download;
                        kind: ButtonKind.primary;
                        y: (parent.height - self.height) / 2;
                        clicked => {
                            InstancesApi.add-lan-instance(item.sync-id);
                        }
                    }
                }
            }
        }
    }

    if InstancesApi.total-count == 0 && InstancesApi.lan-available.length == 0: EmptyState {
        art: Icons.axi;
        title: "Nothing here yet";
        text: "Build your own or grab a modpack.";
        Button {
            text: "Discover modpacks";
            icon: Icons.compass;
            clicked => {
                Nav.page = Page.browse-modpacks;
            }
        }
        Button {
            text: "New instance";
            icon: Icons.plus;
            kind: ButtonKind.primary;
            clicked => {
                Nav.dialog = DialogKind.new-instance;
            }
        }
    }
    if InstancesApi.total-count > 0 && InstancesApi.items.length == 0: EmptyState {
        y: 120px;
        height: parent.height - 120px;
        icon: Icons.search;
        title: "No luck";
        text: "Try another search.";
    }
}
