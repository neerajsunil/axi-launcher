import { Theme } from "../theme.slint";

// On/off switch with an optional label to its right.
export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    callback toggled(bool);

    min-height: 22px;
    opacity: root.enabled ? 1 : 0.5;

    HorizontalLayout {
        spacing: 10px;
        alignment: start;

        track := Rectangle {
            width: 38px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: self.height / 2;
            background: root.checked ? Theme.accent : Theme.control-pressed;
            animate background { duration: 120ms; }

            Rectangle {
                width: 16px;
                height: 16px;
                y: 3px;
                x: root.checked ? parent.width - self.width - 3px : 3px;
                border-radius: self.height / 2;
                background: root.checked ? Theme.on-accent : Theme.text-muted;
                animate x { duration: 120ms; easing: ease-out; }
            }
        }

        if root.text != "": Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
        }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}
