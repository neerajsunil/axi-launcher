import { Theme } from "../theme.slint";

// Underlined tab strip. `current` is the selected index.
export component Tabs inherits Rectangle {
    in property <[string]> tabs;
    in-out property <int> current: 0;

    height: 40px;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        alignment: start;
        spacing: 4px;

        for tab[i] in root.tabs: Rectangle {
            property <bool> active: i == root.current;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: tab;
                    color: active ? Theme.text : touch.has-hover ? Theme.text : Theme.text-muted;
                    font-size: Theme.font-body;
                    font-weight: active ? 700 : 500;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                y: parent.height - 3px;
                height: 3px;
                width: active ? parent.width - 16px : 0;
                border-radius: 2px;
                background: Theme.accent;
                animate width { duration: Theme.normal; easing: ease-out; }
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.current = i;
                }
            }
        }
    }
}
