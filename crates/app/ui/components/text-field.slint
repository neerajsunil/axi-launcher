import { Theme } from "../theme.slint";

// Single-line text input.
export component TextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <image> icon;
    in property <bool> enabled <=> input.enabled;
    in property <InputType> input-type: InputType.text;
    in property <string> font-family;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted(string);

    property <length> pad-left: root.icon.width > 0 ? 34px : 11px;

    height: Theme.control-height;
    min-width: 60px;
    horizontal-stretch: 1;
    border-radius: Theme.radius;
    background: root.enabled ? Theme.control : Theme.surface;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : touch.has-hover ? Theme.border-strong : Theme.border;
    forward-focus: input;

    touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            input.focus();
        }
    }

    if root.icon.width > 0: Image {
        x: 11px;
        source: root.icon;
        colorize: Theme.text-faint;
        width: 15px;
        height: 15px;
    }

    Rectangle {
        x: root.pad-left;
        width: parent.width - root.pad-left - 11px;
        clip: true;

        Text {
            width: 100%;
            height: 100%;
            vertical-alignment: center;
            text: root.text == "" ? root.placeholder : "";
            color: Theme.text-faint;
            font-size: Theme.font-body;
        }

        input := TextInput {
            property <length> computed-x;
            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
            width: max(parent.width - self.text-cursor-width, self.preferred-width);
            height: 100%;
            vertical-alignment: center;
            single-line: true;
            color: root.enabled ? Theme.text : Theme.text-muted;
            font-size: Theme.font-body;
            font-family: root.font-family;
            input-type: root.input-type;
            selection-background-color: Theme.accent-soft;
            selection-foreground-color: Theme.text;

            cursor-position-changed(pos) => {
                if pos.x + self.computed-x < 0 {
                    self.computed-x = -pos.x;
                } else if pos.x + self.computed-x > parent.width - self.text-cursor-width {
                    self.computed-x = parent.width - pos.x - self.text-cursor-width;
                }
            }
            edited => {
                root.edited(self.text);
            }
            accepted => {
                root.accepted(self.text);
            }
        }
    }
}

// Multi-line text input with a fixed height.
export component TextArea inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <string> font-family;
    callback edited(string);

    height: 110px;
    horizontal-stretch: 1;
    border-radius: Theme.radius;
    background: Theme.control;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    forward-focus: input;

    flick := Flickable {
        x: 11px;
        y: 8px;
        width: parent.width - 22px;
        height: parent.height - 16px;
        content-height: max(self.height, input.preferred-height);

        Text {
            width: 100%;
            text: root.text == "" ? root.placeholder : "";
            color: Theme.text-faint;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }

        input := TextInput {
            width: flick.width;
            height: max(flick.height, self.preferred-height);
            single-line: false;
            wrap: word-wrap;
            color: Theme.text;
            font-size: Theme.font-body;
            font-family: root.font-family;
            selection-background-color: Theme.accent-soft;
            selection-foreground-color: Theme.text;
            edited => {
                root.edited(self.text);
            }
        }
    }
}
